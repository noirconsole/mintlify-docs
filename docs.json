{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Noir Console",
  "description": "User manual for Noir Console — X (Twitter) marketing automation platform",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "getting-started/introduction",
          "getting-started/login",
          "getting-started/interface-overview"
        ]
      },
      {
        "group": "Token Manager",
        "icon": "key-round",
        "expanded": true,
        "pages": [
          "token-manager/overview",
          "token-manager/loading-accounts",
          "token-manager/groups",
          "token-manager/unlocker",
          "token-manager/profile-changer",
          "token-manager/proxies"
        ]
      },
      {
        "group": "DexScreener",
        "icon": "chart-line",
        "expanded": true,
        "pages": [
          "dexscreener/overview",
          "dexscreener/new-listings",
          "dexscreener/trending",
          "dexscreener/export-settings"
        ]
      },
      {
        "group": "Scraping",
        "icon": "download",
        "expanded": true,
        "pages": [
          "scraping/overview",
          "scraping/followers-scraper",
          "scraping/universal-scraper",
          "scraping/resolver"
        ]
      },
      {
        "group": "DM (Direct Messages)",
        "icon": "mail",
        "expanded": true,
        "pages": [
          "dm/overview",
          "dm/attaching-accounts",
          "dm/checker",
          "dm/targets",
          "dm/templates",
          "dm/bulk-sending",
          "dm/inbox"
        ]
      },
      {
        "group": "SMM",
        "icon": "heart",
        "expanded": true,
        "pages": [
          "smm/overview",
          "smm/raids",
          "smm/auto-mode",
          "smm/follow",
          "smm/f4f"
        ]
      },
      {
        "group": "Quoting",
        "icon": "quote",
        "expanded": true,
        "pages": [
          "quoting/overview",
          "quoting/quote-tags",
          "quoting/reply-quotes",
          "quoting/wall-posts"
        ]
      },
      {
        "group": "Posting Tool",
        "icon": "send",
        "expanded": true,
        "pages": [
          "posting-tool/overview",
          "posting-tool/creating-posts",
          "posting-tool/boost-groups",
          "posting-tool/task-management"
        ]
      },
      {
        "group": "Lists Tracker",
        "icon": "list",
        "expanded": true,
        "pages": [
          "lists/overview",
          "lists/tracking-lists",
          "lists/feed-view"
        ]
      },
      {
        "group": "Warmer",
        "icon": "flame",
        "expanded": true,
        "pages": [
          "warmer/overview",
          "warmer/warming-accounts",
          "warmer/multi-task"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Get Access",
      "href": "https://noirconsole.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/noirconsole"
    }
  }
}
